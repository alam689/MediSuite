# MediSuite frontend — environment variables
# Copy to `.env` and fill in. All Vite client vars must be prefixed with VITE_.

# Sign-language recognition model endpoint.
# The Accessible Care console POSTs camera frames to this URL and renders the result.
# Contract:
#   Request:  POST { "image": "<jpeg data URL>", "ts": <epoch ms> }
#   Response: { "gloss": "Hello", "confidence": 0.92 }   // or { "text": "..." }
# Can also be set at runtime from the Accessible Care UI (persists to localStorage).
VITE_SIGN_RECOGNITION_URL=
