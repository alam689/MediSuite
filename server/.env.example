# Copy to .env and adjust. Dev values match docker-compose.yml.
API_PORT=4000

# Where the document folders live (defaults to the repo root, which holds
# "Reports/" and "Vaccine Card/").
# DOCS_ROOT=E:/Claude_Projects/AI-Powered Telemedicine Management System

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://aitms:aitms_dev_password@localhost:5432/aitms

# Orthanc PACS — DICOMweb base
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=aitms
ORTHANC_PASSWORD=aitms_dev_password

# MinIO object store
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aitms
S3_SECRET_KEY=aitms_dev_password
